# Rename this file to ".env" (remove .example) and fill
# in your real values below. Never share this file or
# paste its contents in chat — these are your private
# keys.

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHANNELS=

GROQ_API_KEY=

# Telegram pull settings
INITIAL_FETCH_LIMIT=5

# News digest settings
DIGEST_MIN_ITEMS=3
DIGEST_MAX_ITEMS=10

# TTS voice (optional — remove to use default: en-US-AndrewNeural)
# Other option worth trying: en-GB-RyanNeural
# TTS_VOICE=en-US-AndrewNeural# Add these to your existing .env alongside GROQ_API_KEY / TELEGRAM_* vars

# ── db.py ──
# PIPELINE_DB_PATH=pipeline.db          # optional, defaults to ./pipeline.db

# ── YouTube (publish_youtube.py) ──
# 1. Google Cloud Console -> enable "YouTube Data API v3"
# 2. Create OAuth client (type: Desktop app) -> download as client_secret.json
#    into this project directory
YOUTUBE_CLIENT_SECRETS=client_secret.json
YOUTUBE_TOKEN_FILE=youtube_token.json
YOUTUBE_PRIVACY_STATUS=unlisted   # SAFE DEFAULT — do not set to "public" until live-tested

# ── TikTok (publish_tiktok.py) ──
# 1. developers.tiktok.com -> create app -> add "Content Posting API" product
# 2. Complete OAuth once (authorization code flow) to obtain a refresh token
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_REFRESH_TOKEN=
TIKTOK_PRIVACY_LEVEL=SELF_ONLY    # SAFE DEFAULT — also enforced server-side pre-audit
FISH_API_KEY=api_key
FISH_VOICE_ID=the_voice_id
ELEVENLABS_API_KEY=your_key_here
ELEVENLABS_VOICE_ID=the_voice_id_you_picked